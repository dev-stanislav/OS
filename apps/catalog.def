/* MiniPkg GitHub app library v1. Included by kernel/src/apps/app_manager.c. */
PACKAGE(minifetch, "MiniFetch", "1.0", "System information", app_minifetch_start, 0, 0)
PACKAGE(calc, "Calculator", "1.0", "Integer calculator", app_calc_start, 0, 0)
PACKAGE(clock, "Clock", "1.0", "Live uptime clock", app_clock_start, app_clock_key, app_clock_tick)
PACKAGE(files, "Files", "1.0", "RAM filesystem browser", app_files_start, app_files_key, 0)
PACKAGE(matrix, "Matrix", "1.0", "Matrix rain", app_matrix_start, app_matrix_key, app_matrix_tick)
PACKAGE(mines, "MiniMines", "1.0", "8x8 minesweeper", app_mines_start, app_mines_key, 0)
PACKAGE(free, "Text Editor", "2.0", "Luma text editor", app_free_start, app_free_key, app_free_tick)
PACKAGE(tbf, "Files", "2.0", "Luma file manager", app_tbf_start, app_tbf_key, app_tbf_tick)
PACKAGE(paint, "Paint", "1.0", "Canvas drawing with the left mouse button", app_paint_start, app_paint_key, app_paint_tick)
PACKAGE(terminal, "Terminal", "1.0", "Graphical command terminal", app_terminal_start, app_terminal_key, app_terminal_tick)
PACKAGE(luma, "Luma", "1.0", "Minimal MiniOS desktop", app_luma_start, app_luma_key, app_luma_tick)
